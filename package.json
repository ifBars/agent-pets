{
  "name": "agent-pets",
  "version": "0.1.0",
  "private": false,
  "description": "Local-first desktop pets that mirror Codex and agent activity.",
  "main": "src/main.cjs",
  "license": "MIT",
  "homepage": "https://github.com/ifBars/agent-pets#readme",
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ifBars/agent-pets.git"
  },
  "bugs": {
    "url": "https://github.com/ifBars/agent-pets/issues"
  },
  "author": {
    "name": "Agent Pets contributors",
    "email": "agent-pets@example.com"
  },
  "bin": {
    "agent-pets": "bin/agent-pets.cjs",
    "agent-pets-opencode-install": "bin/agent-pets-opencode-install.cjs",
    "agent-pets-emit": "bin/agent-pets-emit.cjs",
    "agent-pets-validate": "bin/agent-pets-validate.cjs",
    "pets": "bin/agent-pets.cjs"
  },
  "scripts": {
    "pets": "electron .",
    "list": "electron . -- --list",
    "validate:pet": "node bin/agent-pets-validate.cjs",
    "qa:pet": "electron skills/agent-pet-maker/scripts/generate-pet-qa.cjs",
    "emit": "node bin/agent-pets-emit.cjs",
    "opencode:install-local": "node bin/agent-pets-opencode-install.cjs",
    "test": "bun test",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "dev.agentpets.desktop",
    "productName": "Agent Pets",
    "copyright": "Copyright (c) 2026 Agent Pets contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "bin/**/*",
      "packages/opencode-agent-pets/**/*",
      "skills/agent-pet-maker/**/*",
      "README.md",
      "LICENSE",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agent Pets"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "synopsis": "Local-first desktop pets for agent status",
      "description": "Agent Pets mirrors local AI coding-agent activity through Codex-compatible desktop pets.",
      "maintainer": "Agent Pets contributors <agent-pets@example.com>"
    }
  },
  "devDependencies": {
    "electron": "^39.2.4",
    "electron-builder": "^26.8.1"
  }
}
