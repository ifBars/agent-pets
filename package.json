{
  "name": "agent-pets",
  "version": "0.1.0",
  "private": false,
  "description": "Local-first desktop pets that mirror Codex and agent activity.",
  "main": "build/src/main.js",
  "license": "MIT",
  "homepage": "https://github.com/ifBars/agent-pets#readme",
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ifBars/agent-pets.git"
  },
  "bugs": {
    "url": "https://github.com/ifBars/agent-pets/issues"
  },
  "author": {
    "name": "Agent Pets contributors",
    "email": "agent-pets@example.com"
  },
  "keywords": [
    "codex",
    "desktop-pets",
    "agent-status",
    "electron",
    "opencode"
  ],
  "bin": {
    "agent-pets": "bin/agent-pets.cjs",
    "agent-pets-opencode-install": "bin/agent-pets-opencode-install.cjs",
    "agent-pets-emit": "bin/agent-pets-emit.cjs",
    "agent-pets-validate": "bin/agent-pets-validate.cjs"
  },
  "files": [
    "build/src/**/*",
    "bin/**/*",
    "packages/opencode-agent-pets/**/*",
    "skills/agent-pet-maker/**/*",
    "media/agent-pets-preview.gif",
    "README.md",
    "PET_CREATION.md",
    "RELEASE.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "prepack": "bun run build",
    "build": "node bin/build-runtime.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "agent-pets": "bun run build && electron .",
    "list": "bun run build && electron . -- --list",
    "validate:pet": "bun run build && node bin/agent-pets-validate.cjs",
    "qa:pet": "bun run build && electron skills/agent-pet-maker/scripts/generate-pet-qa.cjs",
    "clean:pet-edges": "python skills/agent-pet-maker/scripts/clean_pet_edges.py",
    "emit": "bun run build && node bin/agent-pets-emit.cjs",
    "opencode:install-local": "node bin/agent-pets-opencode-install.cjs",
    "test": "bun run build && bun test",
    "pack": "bun run build && electron-builder --dir --publish never",
    "dist": "bun run build && electron-builder --publish never",
    "dist:win": "bun run build && electron-builder --win --publish never",
    "dist:mac": "bun run build && electron-builder --mac --publish never",
    "dist:linux": "bun run build && electron-builder --linux --publish never"
  },
  "build": {
    "appId": "dev.agentpets.desktop",
    "productName": "Agent Pets",
    "copyright": "Copyright (c) 2026 Agent Pets contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "build/src/**/*",
      "bin/**/*",
      "packages/opencode-agent-pets/**/*",
      "skills/agent-pet-maker/**/*",
      "media/agent-pets-preview.gif",
      "README.md",
      "PET_CREATION.md",
      "RELEASE.md",
      "LICENSE",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agent Pets"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "synopsis": "Local-first desktop pets for agent status",
      "description": "Agent Pets mirrors local AI coding-agent activity through Codex-compatible desktop pets.",
      "maintainer": "Agent Pets contributors <agent-pets@example.com>"
    }
  },
  "optionalDependencies": {
    "electron": "^39.2.4"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "electron": "^39.2.4",
    "electron-builder": "^26.8.1",
    "typescript": "^6.0.3"
  }
}
